#!/usr/bin/env bash
set -euo pipefail

SSTOR_DIR="$HOME/dev/sessionator"

# sstor init: install the board's agent set from slop into the current checkout.
if [[ "${1:-}" == "init" ]]; then
  shift
  exec python3 "$SSTOR_DIR/scripts/sstor_init.py" "$@"
fi

SERVER_CMD=""
KILL=false
END=false
DELETE=false
LIST=false
MERGE=false
DERGE=false
SYNC=false
DEPLOY=false
GLOB=""
TAKE_OVER=false
NEW=false
NEW_TYPE=""
NEW_CATEGORY=""
NEW_ROUTINE=false
NEW_PROMPT=""
READY=false
DONE=false
FINALISED=""
REVIEW=""
PROJECT=""
INSTANCE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --server=*) SERVER_CMD="${1#--server=}" ;;
    -s|--server) SERVER_CMD="$2"; shift ;;
    --project=*) PROJECT="${1#--project=}" ;;
    -p|--project) PROJECT="$2"; shift ;;
    --instance=*) INSTANCE="${1#--instance=}" ;;
    -i|--instance) INSTANCE="$2"; shift ;;
    -k|--kill) KILL=true ;;
    -e|--end) END=true ;;
    -d|--delete) DELETE=true ;;
    -l|--list) LIST=true ;;
    -m|--merge) MERGE=true ;;
    -g|--derge) DERGE=true ;;
    --sync) SYNC=true ;;
    --glob=*) GLOB="${1#--glob=}" ;;
    --glob) GLOB="$2"; shift ;;
    --take-over) TAKE_OVER=true ;;
    --new) NEW=true ;;
    --same|--sub|--super) NEW_TYPE="${1#--}" ;;
    --feature|--task|--bug) NEW_CATEGORY="${1#--}" ;;
    --routine) NEW_ROUTINE=true ;;
    --ready) READY=true ;;
    --done) DONE=true ;;
    --finalised=*) FINALISED="${1#--finalised=}" ;;
    --finalised) FINALISED="$2"; shift ;;
    --review=*) REVIEW="${1#--review=}" ;;
    --review) REVIEW="$2"; shift ;;
    --deploy) DEPLOY=true ;;
    -r|--reload)
      set +u
      source ~/.bash_profile
      set -u
      tmux source-file ~/.tmux.conf 2>/dev/null || true
      osascript -e 'tell application "Hammerspoon" to execute lua code "hs.reload()"' 2>/dev/null || true
      echo "Configs reloaded"
      exit 0
      ;;
    -h|--help)
      cat <<'HELP'
sstor — session manager for tmux worktrees and Claude Code

Usage: sstor [options]

Session management:
  -p, --project <name>    Target project (inferred from cwd if omitted)
  -i, --instance <name>   Target instance (worktree)
  -s, --server <cmd>      Start a server window with the given command
                          (auto-read from .sstor/sstor.conf if present)
  -k, --kill              Kill current/target session, switch to next
  -e, --end               Kill current/target session (allows last session)
  -d, --delete            Delete instance: kill session, remove worktree, delete branch
  -l, --list              List all instances for the project

Slop globs (board from SLOP_BOARD in .sstor/sstor.conf):
  --glob <id>             Pick up a glob: worktree on its branch, sstor init, /run-glob
  --take-over             With --glob: supersede an active routine run
  --new "<prompt>"        Create a glob through slop's intake (same by default), then pick it up
     [--same|--sub|--super] [--feature|--task|--bug] [--routine]
                          Subs and --routine sames are left to a routine (nothing opens locally)
  --ready                 Finalise (postplan, local review, learnings), push, mark the PR ready
  -m, --merge             Finalise, then squash-merge the glob's PR on GitHub
  -g, --derge             --merge, then delete the instance
  --done                  Delete the instance of a glob merged elsewhere
  --finalised <id>        With --ready/--merge/--derge: /finalise <id> already ran in Claude
  --review <id|sha>       Review a glob's changes or a commit (no code changes)

Deploy:
  --deploy                Run the project's .sstor/deploy.sh script from the current branch

Slop:
  init [board]            Install the board's agent set from slop into this checkout
                          (board from the argument, SLOP_BOARD, or .sstor/sstor.conf)

Config:
  --sync                  Re-merge Claude config (.claude/) into project/instance
  -r, --reload            Reload bash profile and tmux config

Project config (.sstor/sstor.conf):
  SLOP_BOARD              The project's board in slop
  SLOP_MCP_SERVER         Name of slop's MCP server in Claude Code (default: slop)
HELP
      exit 0
      ;;
    -*) echo "Unknown option: $1"; exit 1 ;;
    *)
      if $NEW; then
        NEW_PROMPT="${NEW_PROMPT:+$NEW_PROMPT }$1"
      else
        echo "Unexpected argument: $1"; exit 1
      fi
      ;;
  esac
  shift
done

# Infer project from current directory if not specified
if [[ -z "$PROJECT" ]]; then
  CURDIR="$(pwd)"
  if [[ "$CURDIR" == *__worktrees/* ]]; then
    # Inside a worktree: extract project and instance from path
    PROJECT="$(basename "$(dirname "$CURDIR")")"
    PROJECT="${PROJECT%__worktrees}"
    if [[ -z "$INSTANCE" ]]; then
      INSTANCE="$(basename "$CURDIR")"
      INSTANCE="${INSTANCE#"${PROJECT}"-}"
    fi
  else
    PROJECT="$(basename "$CURDIR")"
  fi
fi

REPO_DIR="$HOME/dev/$PROJECT"

if [[ ! -d "$REPO_DIR" ]]; then
  echo "Directory not found: $REPO_DIR"
  exit 1
fi

SSTOR_PY="$SSTOR_DIR/scripts"

# Installs the board's agent set from slop into a checkout (sstor init).
slop_init() {
  (cd "$1" && python3 "$SSTOR_PY/sstor_init.py")
}

# Sync Claude config into an existing project/instance
if $SYNC; then
  if [[ -n "$INSTANCE" ]]; then
    SYNC_TARGET="$HOME/dev/${PROJECT}__worktrees/${PROJECT}-${INSTANCE}"
  else
    SYNC_TARGET="$REPO_DIR"
  fi
  if [[ ! -d "$SYNC_TARGET" ]]; then
    echo "Directory not found: $SYNC_TARGET"
    exit 1
  fi
  slop_init "$SYNC_TARGET"
  exit $?
fi

# Trigger project deploy script
if $DEPLOY; then
  DEPLOY_SCRIPT="$REPO_DIR/.sstor/deploy.sh"
  if [[ ! -x "$DEPLOY_SCRIPT" ]]; then
    echo "No deploy script found at $DEPLOY_SCRIPT"
    exit 1
  fi

  # Determine working directory
  if [[ -n "$INSTANCE" ]]; then
    DEPLOY_DIR="$HOME/dev/${PROJECT}__worktrees/${PROJECT}-${INSTANCE}"
  else
    CURDIR="$(pwd)"
    if [[ "$CURDIR" == *__worktrees/* ]]; then
      DEPLOY_DIR="$CURDIR"
    else
      DEPLOY_DIR="$REPO_DIR"
    fi
  fi

  cd "$DEPLOY_DIR"
  exec "$DEPLOY_SCRIPT"
fi

# --new creates a glob through slop's intake; subs and --routine sames stay with a routine.
if $NEW; then
  [[ -n "$NEW_PROMPT" ]] || { echo "Usage: sstor --new [--same|--sub|--super] [--feature|--task|--bug] [--routine] \"<prompt>\""; exit 1; }
  NEW_ARGS=()
  [[ -n "$NEW_TYPE" ]] && NEW_ARGS+=(--type "$NEW_TYPE")
  [[ -n "$NEW_CATEGORY" ]] && NEW_ARGS+=(--category "$NEW_CATEGORY")
  $NEW_ROUTINE && NEW_ARGS+=(--routine)
  CREATED=$(cd "$REPO_DIR" && python3 "$SSTOR_PY/sstor_glob.py" new ${NEW_ARGS[@]+"${NEW_ARGS[@]}"} "$NEW_PROMPT") || exit 1
  eval "$CREATED"
  if [[ "$TYPE" == "sub" ]] || $NEW_ROUTINE; then
    echo "$ID is with a routine ($STATUS). Watch it on the board, or take it over with: sstor --glob $ID --take-over"
    exit 0
  fi
  GLOB="$ID"
fi

# --glob checks and picks up the glob before anything is created locally.
if [[ -n "$GLOB" ]]; then
  PREPARE_ARGS=()
  $TAKE_OVER && PREPARE_ARGS+=(--take-over)
  PREPARED=$(cd "$REPO_DIR" && python3 "$SSTOR_PY/sstor_glob.py" prepare "$GLOB" ${PREPARE_ARGS[@]+"${PREPARE_ARGS[@]}"}) || exit 1
  eval "$PREPARED"
  GLOB="$ID"
  INSTANCE="$ID"
elif [[ -n "$REVIEW" ]]; then
  INSTANCE="review-${REVIEW}"
fi

# --ready: finalise, push and mark the glob's PR ready for review.
if $READY; then
  if [[ -z "$INSTANCE" ]] && [[ "$(pwd)" == *__worktrees/* ]]; then
    INSTANCE="$(basename "$(git rev-parse --show-toplevel)")"; INSTANCE="${INSTANCE#"${PROJECT}"-}"
  fi
  [[ -n "$INSTANCE" ]] || { echo "Usage: sstor -i <glob> --ready"; exit 1; }
  READY_ARGS=()
  [[ -n "$FINALISED" ]] && READY_ARGS+=(--finalised "$FINALISED")
  python3 "$SSTOR_PY/sstor_glob.py" ready "$HOME/dev/${PROJECT}__worktrees/${PROJECT}-${INSTANCE}" "${PROJECT}-${INSTANCE}" ${READY_ARGS[@]+"${READY_ARGS[@]}"}
  exit $?
fi

# Kill server process on the port from .sstor/.url and clean up
cleanup_server() {
  local dir="$1"
  local url_file="$dir/.sstor/.url"
  if [[ -f "$url_file" ]]; then
    local url port
    url=$(cat "$url_file")
    port=$(echo "$url" | grep -oE ':[0-9]+' | tr -d ':')
    if [[ -n "$port" ]]; then
      local pids
      pids=$(lsof -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null) || true
      if [[ -n "$pids" ]]; then
        echo "$pids" | xargs kill 2>/dev/null || true
        echo "Killed server on port $port"
      fi
    fi
    rm -f "$url_file"
  fi
}

# Kill session and switch to next available
if $KILL; then
  if [[ -z "${TMUX:-}" ]]; then
    echo "Not inside a tmux session"
    exit 1
  fi
  if [[ -n "$INSTANCE" ]]; then
    TARGET="${PROJECT}-${INSTANCE}"
  else
    TARGET=$(tmux display-message -p '#S')
  fi
  if ! tmux has-session -t "$TARGET" 2>/dev/null; then
    echo "No session: $TARGET"
    exit 1
  fi
  NEXT=$(tmux list-sessions -F '#S' | grep -v "^${TARGET}$" | head -1) || true
  if [[ -z "$NEXT" ]]; then
    echo "Cannot kill the only remaining session"
    exit 1
  fi
  if [[ "$(tmux display-message -p '#S')" == "$TARGET" ]]; then
    tmux switch-client -t "$NEXT"
  fi
  # Resolve dir for cleanup
  if [[ -n "$INSTANCE" ]]; then
    cleanup_server "$HOME/dev/${PROJECT}__worktrees/$TARGET"
  else
    cleanup_server "$REPO_DIR"
  fi
  tmux kill-session -t "$TARGET"
  exit 0
fi

# End session (like kill but allows killing the last session)
if $END; then
  if [[ -z "${TMUX:-}" ]]; then
    echo "Not inside a tmux session"
    exit 1
  fi
  if [[ -n "$INSTANCE" ]]; then
    TARGET="${PROJECT}-${INSTANCE}"
  else
    TARGET=$(tmux display-message -p '#S')
  fi
  if ! tmux has-session -t "$TARGET" 2>/dev/null; then
    echo "No session: $TARGET"
    exit 1
  fi
  NEXT=$(tmux list-sessions -F '#S' | grep -v "^${TARGET}$" | head -1) || true
  if [[ -n "$NEXT" ]] && [[ "$(tmux display-message -p '#S')" == "$TARGET" ]]; then
    tmux switch-client -t "$NEXT"
  fi
  if [[ -n "$INSTANCE" ]]; then
    cleanup_server "$HOME/dev/${PROJECT}__worktrees/$TARGET"
  else
    cleanup_server "$REPO_DIR"
  fi
  tmux kill-session -t "$TARGET"
  exit 0
fi

# List all instances for this project
if $LIST; then
  WORKTREES_DIR="$HOME/dev/${PROJECT}__worktrees"
  if [[ ! -d "$WORKTREES_DIR" ]]; then
    echo "No instances for $PROJECT"
    exit 0
  fi
  for dir in "$WORKTREES_DIR"/"${PROJECT}"-*/; do
    [[ -d "$dir" ]] || continue
    instance="${dir%/}"
    instance="${instance##*/}"
    instance="${instance#"${PROJECT}"-}"
    session="${PROJECT}-${instance}"
    if tmux has-session -t "$session" 2>/dev/null; then
      echo "$instance (active)"
    else
      echo "$instance"
    fi
  done
  exit 0
fi

# Squash-merge the glob's PR on GitHub (--merge/--derge), then clean up (--derge/--done).
if $MERGE || $DERGE || $DONE; then
  if [[ -z "$INSTANCE" ]] && [[ "$(pwd)" == *__worktrees/* ]]; then
    INSTANCE="$(basename "$(git rev-parse --show-toplevel)")"; INSTANCE="${INSTANCE#"${PROJECT}"-}"
  fi
  if [[ -z "$INSTANCE" ]]; then
    echo "Usage: sstor -i <glob> --merge|--derge|--done"
    exit 1
  fi

  SESSION="${PROJECT}-${INSTANCE}"
  WORKTREE_DIR="$HOME/dev/${PROJECT}__worktrees/$SESSION"

  if $MERGE || $DERGE; then
    MERGE_ARGS=()
    [[ -n "$FINALISED" ]] && MERGE_ARGS+=(--finalised "$FINALISED")
    python3 "$SSTOR_PY/sstor_glob.py" merge "$WORKTREE_DIR" "$SESSION" ${MERGE_ARGS[@]+"${MERGE_ARGS[@]}"} || exit 1
  fi

  if $DERGE || $DONE; then
    if tmux has-session -t "$SESSION" 2>/dev/null; then
      if [[ -n "${TMUX:-}" ]] && [[ "$(tmux display-message -p '#S')" == "$SESSION" ]]; then
        if ! tmux has-session -t "$PROJECT" 2>/dev/null; then
          sstor --project="$PROJECT" </dev/null >/dev/null 2>&1 &
          sleep 1
        fi
        tmux switch-client -t "$PROJECT"
      fi
      cleanup_server "$WORKTREE_DIR"
      tmux kill-session -t "$SESSION"
      echo "Killed session: $SESSION"
    fi
    if [[ -d "$WORKTREE_DIR" ]]; then
      git -C "$REPO_DIR" worktree remove --force "$WORKTREE_DIR"
      echo "Removed worktree: $WORKTREE_DIR"
    fi
    if git -C "$REPO_DIR" rev-parse --verify "$INSTANCE" &>/dev/null; then
      git -C "$REPO_DIR" branch -D "$INSTANCE"
      echo "Deleted branch: $INSTANCE"
    fi
    git -C "$REPO_DIR" fetch --prune --quiet origin || true
  fi
  exit 0
fi

# Delete an instance: kill session, remove worktree, delete branch
if $DELETE; then
  # Infer instance from current tmux session name if not specified
  if [[ -z "$INSTANCE" ]] && [[ -n "${TMUX:-}" ]]; then
    CURRENT=$(tmux display-message -p '#S')
    if [[ "$CURRENT" == "${PROJECT}"-* ]]; then
      INSTANCE="${CURRENT#"${PROJECT}"-}"
    fi
  fi
  if [[ -z "$INSTANCE" ]]; then
    echo "Usage: sstor -i <instance> --delete"
    exit 1
  fi

  SESSION="${PROJECT}-${INSTANCE}"
  WORKTREE_DIR="$HOME/dev/${PROJECT}__worktrees/$SESSION"

  # Remove worktree first (before killing session, since session may have pwd inside it)
  if [[ -d "$WORKTREE_DIR" ]]; then
    git -C "$REPO_DIR" worktree remove --force "$WORKTREE_DIR"
    echo "Removed worktree: $WORKTREE_DIR"
  fi

  # Delete the local branch (glob instances use the glob ID; others the session name)
  for b in "$INSTANCE" "$SESSION"; do
    if git -C "$REPO_DIR" rev-parse --verify "$b" &>/dev/null; then
      git -C "$REPO_DIR" branch -D "$b"
      echo "Deleted branch: $b"
    fi
  done

  # Kill tmux session if it exists
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    # If we're inside this session, switch away first
    if [[ -n "${TMUX:-}" ]] && [[ "$(tmux display-message -p '#S')" == "$SESSION" ]]; then
      NEXT=$(tmux list-sessions -F '#S' | grep -v "^${SESSION}$" | head -1) || true
      if [[ -z "$NEXT" ]]; then
        echo "Cannot delete the only remaining session"
        exit 1
      fi
      tmux switch-client -t "$NEXT"
    fi
    cleanup_server "$WORKTREE_DIR"
    tmux kill-session -t "$SESSION"
    echo "Killed session: $SESSION"
  fi

  exit 0
fi

# Create/attach session
NEW_SETUP=false
if [[ -n "$INSTANCE" ]]; then
  SESSION="${PROJECT}-${INSTANCE}"
  WORKTREE_DIR="$HOME/dev/${PROJECT}__worktrees/$SESSION"

  if [[ ! -d "$WORKTREE_DIR" ]]; then
    mkdir -p "$HOME/dev/${PROJECT}__worktrees"
    if [[ -n "$GLOB" ]]; then
      # The glob's branch is its ID, created by slop on origin.
      git -C "$REPO_DIR" fetch --quiet origin "$GLOB"
      git -C "$REPO_DIR" worktree add --track -B "$GLOB" "$WORKTREE_DIR" "origin/$GLOB"
    else
      git -C "$REPO_DIR" worktree add "$WORKTREE_DIR" -b "$SESSION"
    fi
    # Copy certs directory if it exists in the main repo
    if [[ -d "$REPO_DIR/certs" ]]; then
      cp -r "$REPO_DIR/certs" "$WORKTREE_DIR/certs"
      echo "Copied certs from main repo"
    fi
    NEW_SETUP=true
  fi

  START_DIR="$WORKTREE_DIR"
else
  SESSION="$PROJECT"
  START_DIR="$REPO_DIR"
  if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    NEW_SETUP=true
  fi
fi

if $NEW_SETUP || [[ -n "$GLOB" ]]; then
  # Before Claude starts, so new agents and commands register.
  if ! slop_init "$START_DIR"; then
    [[ -n "$GLOB" ]] && exit 1
    echo "Continuing without a fresh agent set"
  fi
fi

# Read project config from .sstor/sstor.conf (if no --server was passed)
SSTOR_CONF="$REPO_DIR/.sstor/sstor.conf"
if [[ -z "$SERVER_CMD" ]] && [[ -f "$SSTOR_CONF" ]]; then
  _CONF_SERVER_BUILD=""
  _CONF_SERVER_CMD=""
  _CONF_PORT_BASE=""
  _CONF_SERVER_URL_TEMPLATE=""
  while IFS='=' read -r key val; do
    val="${val%\"}" ; val="${val#\"}"  # strip quotes
    case "$key" in
      SERVER_BUILD) _CONF_SERVER_BUILD="$val" ;;
      SERVER_CMD)   _CONF_SERVER_CMD="$val" ;;
      PORT_BASE)    _CONF_PORT_BASE="$val" ;;
      SERVER_URL_TEMPLATE) _CONF_SERVER_URL_TEMPLATE="$val" ;;
    esac
  done < "$SSTOR_CONF"

  if [[ -n "$_CONF_SERVER_CMD" ]]; then
    # Find a free port starting from PORT_BASE
    if [[ -n "$_CONF_PORT_BASE" ]]; then
      PORT="$_CONF_PORT_BASE"
      while lsof -iTCP:"$PORT" -sTCP:LISTEN -t &>/dev/null; do
        PORT=$((PORT + 1))
      done
      echo "Server port: $PORT"
      _CONF_SERVER_CMD="${_CONF_SERVER_CMD//\{PORT\}/$PORT}"
    fi

    # Write the server URL
    if [[ -n "$_CONF_SERVER_URL_TEMPLATE" ]] && [[ -n "$PORT" ]]; then
      mkdir -p "$START_DIR/.sstor"
      SERVER_URL="${_CONF_SERVER_URL_TEMPLATE//\{PORT\}/$PORT}"
      echo "$SERVER_URL" > "$START_DIR/.sstor/.url"
      echo "Server URL: $SERVER_URL"
    fi

    # Build the full server command
    if [[ -n "$_CONF_SERVER_BUILD" ]]; then
      SERVER_CMD="$_CONF_SERVER_BUILD && $_CONF_SERVER_CMD"
    else
      SERVER_CMD="$_CONF_SERVER_CMD"
    fi
  fi
fi

# Attach if outside tmux, switch-client if inside tmux.
tmux_go() {
  local session="$1"
  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "=$session"
  else
    exec tmux attach -t "=$session"
  fi
}

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  tmux_go "$SESSION"
fi

WINDOW=1

# Window 1: claude
tmux new-session -d -s "$SESSION" -c "$START_DIR" -n claude
if [[ -n "$GLOB" ]]; then
  tmux send-keys -t "$SESSION":$WINDOW "claude '/run-glob $GLOB'" C-m
elif [[ -n "$REVIEW" ]]; then
  tmux send-keys -t "$SESSION":$WINDOW "claude '/run-glob --review $REVIEW'" C-m
else
  tmux send-keys -t "$SESSION":$WINDOW 'claude --continue' C-m
fi

# Window 2: console
WINDOW=$((WINDOW + 1))
tmux new-window  -t "$SESSION":$WINDOW -n console -c "$START_DIR"

# Window 3: editor
WINDOW=$((WINDOW + 1))
tmux new-window  -t "$SESSION":$WINDOW -n editor -c "$START_DIR"
tmux send-keys   -t "$SESSION":$WINDOW "nvim -c 'Git | only'" C-m

# Window 4: server (optional)
# Window 4: server (optional)
if [[ -n "$SERVER_CMD" ]]; then
  WINDOW=$((WINDOW + 1))
  tmux new-window  -t "$SESSION":$WINDOW -n server -c "$START_DIR"
  tmux send-keys   -t "$SESSION":$WINDOW "$SERVER_CMD" C-m
fi

tmux select-window -t "$SESSION":1
tmux_go "$SESSION"
