#!/usr/bin/env bash
set -euo pipefail

SSTOR_DIR="$HOME/dev/sessionator"
SSTOR_PY="$SSTOR_DIR/scripts"

# Everything that talks to slop goes through the slop CLI (the slop repo's apps/cli).
SLOP_CLI="${SLOP_CLI:-slop}"
MERGE_WAIT_S=1800

slop_cli() {
  case "$SLOP_CLI" in
    *.mjs|*.js) node "$SLOP_CLI" "$@" ;;
    *) "$SLOP_CLI" "$@" ;;
  esac
}

# True when the slop CLI can run; otherwise says how to get it.
slop_runnable() {
  local ok=true
  case "$SLOP_CLI" in
    *.mjs|*.js) [[ -f "$SLOP_CLI" ]] && command -v node >/dev/null || ok=false ;;
    */*) [[ -x "$SLOP_CLI" ]] || ok=false ;;
    *) command -v "$SLOP_CLI" >/dev/null || ok=false ;;
  esac
  if ! $ok; then
    echo "sstor: the slop CLI ($SLOP_CLI) is not runnable. Build it in the slop repo (apps/cli: npm run build)" >&2
    echo "       and put it on PATH as slop, or set SLOP_CLI=/path/to/slop/apps/cli/dist/slop.mjs" >&2
    return 1
  fi
}

require_slop() {
  slop_runnable || exit 1
}

# One field of the JSON object slop printed on stdin (empty when missing).
json_field() {
  python3 -c 'import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    data = None
if not isinstance(data, dict):
    sys.exit("sstor: slop returned unexpected output (expected a JSON object)")
value = data.get(sys.argv[1])
print("" if value is None else str(value).lower() if isinstance(value, bool) else value)' "$1"
}

# Installs the board's agent set (slop init [board]) into a checkout, then merges the developer's
# personal .claude/settings.local.json from sessionator (never from slop).
checkout_init() {
  local dir="$1"; shift
  local status=0
  if slop_runnable; then
    (cd "$dir" && slop_cli init "$@") || status=$?
  else
    status=1
  fi
  python3 "$SSTOR_PY/sstor_init.py" "$SSTOR_DIR/.claude/settings.local.json" "$dir" || status=1
  return $status
}

# sstor init [board]: slop init, then the personal settings merge, in the current checkout.
if [[ "${1:-}" == "init" ]]; then
  shift
  ROOT="$(git rev-parse --show-toplevel)" || exit 1
  checkout_init "$ROOT" "$@"
  exit $?
fi

# sstor login / logout: the slop CLI's own sign-in.
if [[ "${1:-}" == "login" || "${1:-}" == "logout" ]]; then
  require_slop
  slop_cli "$1"
  exit $?
fi

SERVER_CMD=""
KILL=false
END=false
DELETE=false
LIST=false
MERGE=false
DERGE=false
SYNC=false
DEPLOY=false
GLOB=""
TAKE_OVER=false
NEW=false
NEW_TYPE=""
NEW_CATEGORY=""
NEW_ROUTINE=false
NEW_PROMPT=""
READY=false
DONE=false
FINALISED=""
REVIEW=""
PROJECT=""
INSTANCE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --server=*) SERVER_CMD="${1#--server=}" ;;
    -s|--server) SERVER_CMD="$2"; shift ;;
    --project=*) PROJECT="${1#--project=}" ;;
    -p|--project) PROJECT="$2"; shift ;;
    --instance=*) INSTANCE="${1#--instance=}" ;;
    -i|--instance) INSTANCE="$2"; shift ;;
    -k|--kill) KILL=true ;;
    -e|--end) END=true ;;
    -d|--delete) DELETE=true ;;
    -l|--list) LIST=true ;;
    -m|--merge) MERGE=true ;;
    -g|--derge) DERGE=true ;;
    --sync) SYNC=true ;;
    --glob=*) GLOB="${1#--glob=}" ;;
    --glob) GLOB="$2"; shift ;;
    --take-over) TAKE_OVER=true ;;
    --new) NEW=true ;;
    --same|--sub|--super) NEW_TYPE="${1#--}" ;;
    --feature|--task|--bug) NEW_CATEGORY="${1#--}" ;;
    --routine) NEW_ROUTINE=true ;;
    --ready) READY=true ;;
    --done) DONE=true ;;
    --finalised=*) FINALISED="${1#--finalised=}" ;;
    --finalised) FINALISED="$2"; shift ;;
    --review=*) REVIEW="${1#--review=}" ;;
    --review) REVIEW="$2"; shift ;;
    --deploy) DEPLOY=true ;;
    -r|--reload)
      set +u
      source ~/.bash_profile
      set -u
      tmux source-file ~/.tmux.conf 2>/dev/null || true
      osascript -e 'tell application "Hammerspoon" to execute lua code "hs.reload()"' 2>/dev/null || true
      echo "Configs reloaded"
      exit 0
      ;;
    -h|--help)
      cat <<'HELP'
sstor — session manager for tmux worktrees and Claude Code

Usage: sstor [options]

Session management:
  -p, --project <name>    Target project (inferred from cwd if omitted)
  -i, --instance <name>   Target instance (worktree)
  -s, --server <cmd>      Start a server window with the given command
                          (auto-read from .sstor/sstor.conf if present)
  -k, --kill              Kill current/target session, switch to next
  -e, --end               Kill current/target session (allows last session)
  -d, --delete            Delete instance: kill session, remove worktree, delete branch
  -l, --list              List all instances for the project

Slop globs (through the slop CLI; board from SLOP_BOARD in .sstor/sstor.conf):
  --glob <id>             Pick up a glob (slop pick-up), make its worktree on its branch,
                          slop init + personal settings, launch /run-glob
  --take-over             With --glob: supersede a queued or active routine run
  --new "<prompt>"        Create a glob through slop's intake (slop new; same by default),
     [--same|--sub|--super] [--feature|--task|--bug] [--routine]
                          then pick it up. Subs and --routine sames are left to a routine
                          (nothing opens locally)
  --ready                 /finalise in Claude, then slop ready (push, mark the PR ready)
  -m, --merge             /finalise in Claude, then slop merge (like the glob's Merge button)
  -g, --derge             --merge, wait for slop to finish merging, then delete the instance
  --done                  Delete the instance of a glob merged elsewhere
  --finalised <id>        With --ready/--merge/--derge: /finalise <id> already ran in Claude
  --review <id|sha>       Review a glob's changes or a commit (no code changes)

Deploy:
  --deploy                Run the project's .sstor/deploy.sh script from the current branch

Slop:
  init [board]            slop init [board] in this checkout (the board's agent set), then merge
                          your personal ~/dev/sessionator/.claude/settings.local.json into it
  login                   slop login (sign in to slop in the browser)
  logout                  slop logout

Config:
  --sync                  Re-run init (slop init + personal settings) in project/instance
  -r, --reload            Reload bash profile and tmux config

Project config (.sstor/sstor.conf):
  SLOP_BOARD              The project's board in slop (read by the slop CLI)

Environment:
  SLOP_CLI                The slop CLI to run (default: slop on PATH), e.g.
                          SLOP_CLI=~/dev/slop/apps/cli/dist/slop.mjs
                          Its own settings (SLOP_URL, SLOP_CLIENT_ID, ...): slop --help
HELP
      exit 0
      ;;
    -*) echo "Unknown option: $1"; exit 1 ;;
    *)
      if $NEW; then
        NEW_PROMPT="${NEW_PROMPT:+$NEW_PROMPT }$1"
      else
        echo "Unexpected argument: $1"; exit 1
      fi
      ;;
  esac
  shift
done

# Infer project from current directory if not specified
if [[ -z "$PROJECT" ]]; then
  CURDIR="$(pwd)"
  if [[ "$CURDIR" == *__worktrees/* ]]; then
    # Inside a worktree: extract project and instance from path
    PROJECT="$(basename "$(dirname "$CURDIR")")"
    PROJECT="${PROJECT%__worktrees}"
    if [[ -z "$INSTANCE" ]]; then
      INSTANCE="$(basename "$CURDIR")"
      INSTANCE="${INSTANCE#"${PROJECT}"-}"
    fi
  else
    PROJECT="$(basename "$CURDIR")"
  fi
fi

REPO_DIR="$HOME/dev/$PROJECT"

if [[ ! -d "$REPO_DIR" ]]; then
  echo "Directory not found: $REPO_DIR"
  exit 1
fi

# Sync Claude config into an existing project/instance
if $SYNC; then
  if [[ -n "$INSTANCE" ]]; then
    SYNC_TARGET="$HOME/dev/${PROJECT}__worktrees/${PROJECT}-${INSTANCE}"
  else
    SYNC_TARGET="$REPO_DIR"
  fi
  if [[ ! -d "$SYNC_TARGET" ]]; then
    echo "Directory not found: $SYNC_TARGET"
    exit 1
  fi
  checkout_init "$SYNC_TARGET"
  exit $?
fi

# Trigger project deploy script
if $DEPLOY; then
  DEPLOY_SCRIPT="$REPO_DIR/.sstor/deploy.sh"
  if [[ ! -x "$DEPLOY_SCRIPT" ]]; then
    echo "No deploy script found at $DEPLOY_SCRIPT"
    exit 1
  fi

  # Determine working directory
  if [[ -n "$INSTANCE" ]]; then
    DEPLOY_DIR="$HOME/dev/${PROJECT}__worktrees/${PROJECT}-${INSTANCE}"
  else
    CURDIR="$(pwd)"
    if [[ "$CURDIR" == *__worktrees/* ]]; then
      DEPLOY_DIR="$CURDIR"
    else
      DEPLOY_DIR="$REPO_DIR"
    fi
  fi

  cd "$DEPLOY_DIR"
  exec "$DEPLOY_SCRIPT"
fi

# --new creates a glob through slop's intake; subs and --routine sames stay with a routine.
if $NEW; then
  [[ -n "$NEW_PROMPT" ]] || { echo "Usage: sstor --new [--same|--sub|--super] [--feature|--task|--bug] [--routine] \"<prompt>\""; exit 1; }
  require_slop
  NEW_ARGS=()
  [[ -n "$NEW_TYPE" ]] && NEW_ARGS+=("--$NEW_TYPE")
  [[ -n "$NEW_CATEGORY" ]] && NEW_ARGS+=("--$NEW_CATEGORY")
  $NEW_ROUTINE && NEW_ARGS+=(--routine)
  CREATED=$(cd "$REPO_DIR" && slop_cli new ${NEW_ARGS[@]+"${NEW_ARGS[@]}"} --json "$NEW_PROMPT") || exit 1
  ID=$(json_field id <<<"$CREATED")
  TYPE=$(json_field type <<<"$CREATED")
  STATUS=$(json_field status <<<"$CREATED")
  echo "sstor: created $ID ($TYPE, $(json_field category <<<"$CREATED")): $STATUS" >&2
  if [[ "$(json_field routine <<<"$CREATED")" == "true" ]] || [[ "$TYPE" == "sub" ]] || $NEW_ROUTINE; then
    echo "$ID is with a routine ($STATUS). Watch it on the board, or take it over with: sstor --glob $ID --take-over"
    exit 0
  fi
  GLOB="$ID"
fi

# --glob picks up the glob (slop waits for its branch) before anything is created locally.
if [[ -n "$GLOB" ]]; then
  require_slop
  PICK_UP_ARGS=("$GLOB")
  $TAKE_OVER && PICK_UP_ARGS+=(--take-over)
  BRANCH=$(cd "$REPO_DIR" && slop_cli pick-up "${PICK_UP_ARGS[@]}") || exit 1
  # The glob's branch is its ID; anything else must not reach git or the worktree path.
  if [[ "$BRANCH" != "$GLOB" ]]; then
    echo "sstor: slop gave the branch '$BRANCH' for $GLOB; expected the glob ID" >&2
    exit 1
  fi
  INSTANCE="$GLOB"
elif [[ -n "$REVIEW" ]]; then
  # The value is typed into the Claude window, so only a glob ID or a commit SHA gets through.
  GLOB_ID_RE='^s[1-9][0-9]*[ftbh][1-9][0-9]*$'
  SHA_RE='^[0-9a-fA-F]{7,40}$'
  if ! [[ "$REVIEW" =~ $GLOB_ID_RE || "$REVIEW" =~ $SHA_RE ]]; then
    echo "sstor: --review takes a glob ID (like s1t4) or a commit SHA, not '$REVIEW'" >&2
    exit 1
  fi
  INSTANCE="review-${REVIEW}"
fi

# Runs /finalise in the instance's Claude window (unless --finalised), checks its marker and
# prints the request ID.
finalise() {
  local worktree="$1" session="$2"
  local args=()
  [[ -n "$FINALISED" ]] && args+=(--finalised "$FINALISED")
  [[ -d "$worktree" ]] || { echo "sstor: no worktree at $worktree" >&2; return 1; }
  python3 "$SSTOR_PY/sstor_glob.py" finalise "$worktree" "$session" ${args[@]+"${args[@]}"}
}

# Checks sign-in and reachability before the (slow) /finalise handshake.
slop_signed_in() {
  slop_cli whoami >/dev/null || {
    echo "sstor: slop is unreachable or you are not signed in (sstor login); nothing was finalised" >&2
    return 1
  }
}

# After a successful /finalise, a failed slop step shouldn't make the user finalise again.
finalised_hint() {
  echo "sstor: /finalise already ran; once fixed, re-run: sstor -i $INSTANCE $1 --finalised $2" >&2
}

# Refuses when the worktree holds work that isn't on origin/<id> (it would be lost on cleanup).
require_pushed() {
  local dir="$1" id="$2" ahead
  if [[ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]]; then
    echo "sstor: $id has uncommitted changes in $dir; commit them and run sstor -i $id --ready (or push) first. Nothing was merged or deleted" >&2
    return 1
  fi
  git -C "$dir" fetch --quiet origin "$id" || { echo "sstor: could not fetch origin/$id" >&2; return 1; }
  ahead=$(git -C "$dir" rev-list --count "origin/$id..HEAD") || return 1
  if [[ "$ahead" != "0" ]]; then
    echo "sstor: $id has $ahead commit(s) not on origin; run sstor -i $id --ready (or push) first. Nothing was merged or deleted" >&2
    return 1
  fi
}

# --ready: finalise, then slop ready (push, mark the glob's PR ready for review).
if $READY; then
  if [[ -z "$INSTANCE" ]] && [[ "$(pwd)" == *__worktrees/* ]]; then
    INSTANCE="$(basename "$(git rev-parse --show-toplevel)")"; INSTANCE="${INSTANCE#"${PROJECT}"-}"
  fi
  [[ -n "$INSTANCE" ]] || { echo "Usage: sstor -i <glob> --ready"; exit 1; }
  require_slop
  slop_signed_in || exit 1
  READY_DIR="$HOME/dev/${PROJECT}__worktrees/${PROJECT}-${INSTANCE}"
  REQUEST=$(finalise "$READY_DIR" "${PROJECT}-${INSTANCE}") || exit 1
  if ! (cd "$READY_DIR" && slop_cli ready "$INSTANCE"); then
    finalised_hint --ready "$REQUEST"
    exit 1
  fi
  exit 0
fi

# Kill server process on the port from .sstor/.url and clean up
cleanup_server() {
  local dir="$1"
  local url_file="$dir/.sstor/.url"
  if [[ -f "$url_file" ]]; then
    local url port
    url=$(cat "$url_file")
    port=$(echo "$url" | grep -oE ':[0-9]+' | tr -d ':')
    if [[ -n "$port" ]]; then
      local pids
      pids=$(lsof -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null) || true
      if [[ -n "$pids" ]]; then
        echo "$pids" | xargs kill 2>/dev/null || true
        echo "Killed server on port $port"
      fi
    fi
    rm -f "$url_file"
  fi
}

# Kill session and switch to next available
if $KILL; then
  if [[ -z "${TMUX:-}" ]]; then
    echo "Not inside a tmux session"
    exit 1
  fi
  if [[ -n "$INSTANCE" ]]; then
    TARGET="${PROJECT}-${INSTANCE}"
  else
    TARGET=$(tmux display-message -p '#S')
  fi
  if ! tmux has-session -t "$TARGET" 2>/dev/null; then
    echo "No session: $TARGET"
    exit 1
  fi
  NEXT=$(tmux list-sessions -F '#S' | grep -v "^${TARGET}$" | head -1) || true
  if [[ -z "$NEXT" ]]; then
    echo "Cannot kill the only remaining session"
    exit 1
  fi
  if [[ "$(tmux display-message -p '#S')" == "$TARGET" ]]; then
    tmux switch-client -t "$NEXT"
  fi
  # Resolve dir for cleanup
  if [[ -n "$INSTANCE" ]]; then
    cleanup_server "$HOME/dev/${PROJECT}__worktrees/$TARGET"
  else
    cleanup_server "$REPO_DIR"
  fi
  tmux kill-session -t "$TARGET"
  exit 0
fi

# End session (like kill but allows killing the last session)
if $END; then
  if [[ -z "${TMUX:-}" ]]; then
    echo "Not inside a tmux session"
    exit 1
  fi
  if [[ -n "$INSTANCE" ]]; then
    TARGET="${PROJECT}-${INSTANCE}"
  else
    TARGET=$(tmux display-message -p '#S')
  fi
  if ! tmux has-session -t "$TARGET" 2>/dev/null; then
    echo "No session: $TARGET"
    exit 1
  fi
  NEXT=$(tmux list-sessions -F '#S' | grep -v "^${TARGET}$" | head -1) || true
  if [[ -n "$NEXT" ]] && [[ "$(tmux display-message -p '#S')" == "$TARGET" ]]; then
    tmux switch-client -t "$NEXT"
  fi
  if [[ -n "$INSTANCE" ]]; then
    cleanup_server "$HOME/dev/${PROJECT}__worktrees/$TARGET"
  else
    cleanup_server "$REPO_DIR"
  fi
  tmux kill-session -t "$TARGET"
  exit 0
fi

# List all instances for this project
if $LIST; then
  WORKTREES_DIR="$HOME/dev/${PROJECT}__worktrees"
  if [[ ! -d "$WORKTREES_DIR" ]]; then
    echo "No instances for $PROJECT"
    exit 0
  fi
  for dir in "$WORKTREES_DIR"/"${PROJECT}"-*/; do
    [[ -d "$dir" ]] || continue
    instance="${dir%/}"
    instance="${instance##*/}"
    instance="${instance#"${PROJECT}"-}"
    session="${PROJECT}-${instance}"
    if tmux has-session -t "$session" 2>/dev/null; then
      echo "$instance (active)"
    else
      echo "$instance"
    fi
  done
  exit 0
fi

# Merge the glob through slop (--merge/--derge), then clean up (--derge/--done).
if $MERGE || $DERGE || $DONE; then
  if [[ -z "$INSTANCE" ]] && [[ "$(pwd)" == *__worktrees/* ]]; then
    INSTANCE="$(basename "$(git rev-parse --show-toplevel)")"; INSTANCE="${INSTANCE#"${PROJECT}"-}"
  fi
  if [[ -z "$INSTANCE" ]]; then
    echo "Usage: sstor -i <glob> --merge|--derge|--done"
    exit 1
  fi

  SESSION="${PROJECT}-${INSTANCE}"
  WORKTREE_DIR="$HOME/dev/${PROJECT}__worktrees/$SESSION"

  if $MERGE || $DERGE; then
    require_slop
    [[ -d "$WORKTREE_DIR" ]] || { echo "sstor: no worktree at $WORKTREE_DIR" >&2; exit 1; }
    $DERGE && MERGE_FLAG=--derge || MERGE_FLAG=--merge
    slop_signed_in || exit 1
    CURRENT=$(cd "$WORKTREE_DIR" && slop_cli glob "$INSTANCE" --json) || exit 1
    MERGE_STATUS=$(json_field status <<<"$CURRENT")
    case "$MERGE_STATUS" in
      merging|reviewing|signed_off)
        # A re-run after the merge started: no second /finalise, and slop would refuse a merge.
        echo "sstor: $INSTANCE is already $MERGE_STATUS; skipping /finalise and merge" >&2
        # Cleanup force-removes the worktree, so uncommitted tracked work would be lost. (Unpushed
        # commits can't be checked here: the merged branch may already be gone from origin.)
        if $DERGE && [[ -n "$(git -C "$WORKTREE_DIR" status --porcelain --untracked-files=no)" ]]; then
          echo "sstor: $INSTANCE has uncommitted changes in $WORKTREE_DIR; save them elsewhere first. Nothing was deleted" >&2
          exit 1
        fi
        ;;
      *)
        if $DERGE; then require_pushed "$WORKTREE_DIR" "$INSTANCE" || exit 1; fi
        REQUEST=$(finalise "$WORKTREE_DIR" "$SESSION") || exit 1
        # /finalise may have committed; that work must reach origin before the merge.
        if $DERGE && ! require_pushed "$WORKTREE_DIR" "$INSTANCE"; then
          finalised_hint "$MERGE_FLAG" "$REQUEST"
          exit 1
        fi
        # slop refuses a draft PR or failing checks itself (exit 1, with its message).
        if ! MERGED=$(cd "$WORKTREE_DIR" && slop_cli merge "$INSTANCE" --json); then
          finalised_hint "$MERGE_FLAG" "$REQUEST"
          exit 1
        fi
        MERGE_STATUS=$(json_field status <<<"$MERGED")
        ;;
    esac
    if $DERGE; then
      # slop updates the branch, reruns checks and squash-merges; delete nothing until it has.
      DONE_HINT="Once it is merged, run: sstor -i $INSTANCE --done"
      DEADLINE=$((SECONDS + MERGE_WAIT_S))
      POLL_FAILS=0
      while [[ "$MERGE_STATUS" == "merging" ]] && (( SECONDS < DEADLINE )); do
        echo "sstor: waiting for slop to merge $INSTANCE..." >&2
        sleep 15
        if POLLED=$(cd "$WORKTREE_DIR" && slop_cli glob "$INSTANCE" --json) && POLLED_STATUS=$(json_field status <<<"$POLLED"); then
          MERGE_STATUS="$POLLED_STATUS"
          POLL_FAILS=0
        else
          POLL_FAILS=$((POLL_FAILS + 1))
          if (( POLL_FAILS >= 4 )); then
            echo "sstor: could not read $INSTANCE's status from slop ($POLL_FAILS tries); the instance is kept. $DONE_HINT (or re-run sstor -i $INSTANCE --derge)" >&2
            exit 1
          fi
        fi
      done
      case "$MERGE_STATUS" in
        reviewing|signed_off) ;;
        merging)
          echo "sstor: $INSTANCE is still merging after $((MERGE_WAIT_S / 60)) min; the instance is kept. $DONE_HINT (or re-run sstor -i $INSTANCE --derge)" >&2
          exit 1
          ;;
        *)
          echo "sstor: $INSTANCE is $MERGE_STATUS, not merged; the instance is kept (see the glob view). $DONE_HINT" >&2
          exit 1
          ;;
      esac
      echo "sstor: $INSTANCE merged ($MERGE_STATUS)"
    elif [[ "$MERGE_STATUS" == "merging" ]]; then
      echo "sstor: $INSTANCE is merging; slop updates the branch, reruns checks and squash-merges"
    else
      echo "sstor: $INSTANCE: $MERGE_STATUS"
    fi
  fi

  if $DERGE || $DONE; then
    KILL_SESSION=false
    if tmux has-session -t "=$SESSION" 2>/dev/null; then
      KILL_SESSION=true
      # Run from inside the session being removed: move the client away first, and kill the
      # session last (the kill ends this very process).
      if [[ -n "${TMUX:-}" ]] && [[ "$(tmux display-message -p '#S')" == "$SESSION" ]]; then
        SWITCH_TO=""
        if tmux has-session -t "=$PROJECT" 2>/dev/null; then
          SWITCH_TO="$PROJECT"
        elif tmux new-session -d -s "$PROJECT" -c "$REPO_DIR" 2>/dev/null; then
          SWITCH_TO="$PROJECT"
          echo "Created session: $PROJECT"
        else
          SWITCH_TO=$(tmux list-sessions -F '#S' | grep -vx "$SESSION" | head -1) || true
        fi
        if [[ -n "$SWITCH_TO" ]] && tmux switch-client -t "=$SWITCH_TO"; then
          echo "Switched client to session: $SWITCH_TO"
        else
          KILL_SESSION=false
          echo "sstor: no other session to switch to; session $SESSION is kept (kill it with: tmux kill-session -t $SESSION)" >&2
        fi
      fi
      cleanup_server "$WORKTREE_DIR"
    fi
    if [[ -d "$WORKTREE_DIR" ]]; then
      git -C "$REPO_DIR" worktree remove --force "$WORKTREE_DIR"
      echo "Removed worktree: $WORKTREE_DIR"
    fi
    if git -C "$REPO_DIR" rev-parse --verify "$INSTANCE" &>/dev/null; then
      git -C "$REPO_DIR" branch -D "$INSTANCE"
      echo "Deleted branch: $INSTANCE"
    fi
    git -C "$REPO_DIR" fetch --prune --quiet origin || true
    if $KILL_SESSION; then
      echo "Killed session: $SESSION"
      tmux kill-session -t "=$SESSION"
    fi
  fi
  exit 0
fi

# Delete an instance: kill session, remove worktree, delete branch
if $DELETE; then
  # Infer instance from current tmux session name if not specified
  if [[ -z "$INSTANCE" ]] && [[ -n "${TMUX:-}" ]]; then
    CURRENT=$(tmux display-message -p '#S')
    if [[ "$CURRENT" == "${PROJECT}"-* ]]; then
      INSTANCE="${CURRENT#"${PROJECT}"-}"
    fi
  fi
  if [[ -z "$INSTANCE" ]]; then
    echo "Usage: sstor -i <instance> --delete"
    exit 1
  fi

  SESSION="${PROJECT}-${INSTANCE}"
  WORKTREE_DIR="$HOME/dev/${PROJECT}__worktrees/$SESSION"

  # Remove worktree first (before killing session, since session may have pwd inside it)
  if [[ -d "$WORKTREE_DIR" ]]; then
    git -C "$REPO_DIR" worktree remove --force "$WORKTREE_DIR"
    echo "Removed worktree: $WORKTREE_DIR"
  fi

  # Delete the local branch (glob instances use the glob ID; others the session name)
  for b in "$INSTANCE" "$SESSION"; do
    if git -C "$REPO_DIR" rev-parse --verify "$b" &>/dev/null; then
      git -C "$REPO_DIR" branch -D "$b"
      echo "Deleted branch: $b"
    fi
  done

  # Kill tmux session if it exists
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    # If we're inside this session, switch away first
    if [[ -n "${TMUX:-}" ]] && [[ "$(tmux display-message -p '#S')" == "$SESSION" ]]; then
      NEXT=$(tmux list-sessions -F '#S' | grep -v "^${SESSION}$" | head -1) || true
      if [[ -z "$NEXT" ]]; then
        echo "Cannot delete the only remaining session"
        exit 1
      fi
      tmux switch-client -t "$NEXT"
    fi
    cleanup_server "$WORKTREE_DIR"
    tmux kill-session -t "$SESSION"
    echo "Killed session: $SESSION"
  fi

  exit 0
fi

# Create/attach session
NEW_SETUP=false
if [[ -n "$INSTANCE" ]]; then
  SESSION="${PROJECT}-${INSTANCE}"
  WORKTREE_DIR="$HOME/dev/${PROJECT}__worktrees/$SESSION"

  if [[ ! -d "$WORKTREE_DIR" ]]; then
    mkdir -p "$HOME/dev/${PROJECT}__worktrees"
    if [[ -n "$GLOB" ]]; then
      # The glob's branch is its ID, created by slop on origin.
      git -C "$REPO_DIR" fetch --quiet origin "$GLOB"
      git -C "$REPO_DIR" worktree add --track -B "$GLOB" "$WORKTREE_DIR" "origin/$GLOB"
    else
      git -C "$REPO_DIR" worktree add "$WORKTREE_DIR" -b "$SESSION"
    fi
    # Copy certs directory if it exists in the main repo
    if [[ -d "$REPO_DIR/certs" ]]; then
      cp -r "$REPO_DIR/certs" "$WORKTREE_DIR/certs"
      echo "Copied certs from main repo"
    fi
    NEW_SETUP=true
  fi

  START_DIR="$WORKTREE_DIR"
else
  SESSION="$PROJECT"
  START_DIR="$REPO_DIR"
  if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    NEW_SETUP=true
  fi
fi

# Read project config from .sstor/sstor.conf (if no --server was passed)
SSTOR_CONF="$REPO_DIR/.sstor/sstor.conf"
if [[ -z "$SERVER_CMD" ]] && [[ -f "$SSTOR_CONF" ]]; then
  _CONF_SERVER_BUILD=""
  _CONF_SERVER_CMD=""
  _CONF_PORT_BASE=""
  _CONF_SERVER_URL_TEMPLATE=""
  while IFS='=' read -r key val; do
    val="${val%\"}" ; val="${val#\"}"  # strip quotes
    case "$key" in
      SERVER_BUILD) _CONF_SERVER_BUILD="$val" ;;
      SERVER_CMD)   _CONF_SERVER_CMD="$val" ;;
      PORT_BASE)    _CONF_PORT_BASE="$val" ;;
      SERVER_URL_TEMPLATE) _CONF_SERVER_URL_TEMPLATE="$val" ;;
    esac
  done < "$SSTOR_CONF"

  if [[ -n "$_CONF_SERVER_CMD" ]]; then
    # Find a free port starting from PORT_BASE
    if [[ -n "$_CONF_PORT_BASE" ]]; then
      PORT="$_CONF_PORT_BASE"
      while lsof -iTCP:"$PORT" -sTCP:LISTEN -t &>/dev/null; do
        PORT=$((PORT + 1))
      done
      echo "Server port: $PORT"
      _CONF_SERVER_CMD="${_CONF_SERVER_CMD//\{PORT\}/$PORT}"
    fi

    # Write the server URL
    if [[ -n "$_CONF_SERVER_URL_TEMPLATE" ]] && [[ -n "$PORT" ]]; then
      mkdir -p "$START_DIR/.sstor"
      SERVER_URL="${_CONF_SERVER_URL_TEMPLATE//\{PORT\}/$PORT}"
      echo "$SERVER_URL" > "$START_DIR/.sstor/.url"
      echo "Server URL: $SERVER_URL"
    fi

    # Build the full server command
    if [[ -n "$_CONF_SERVER_BUILD" ]]; then
      SERVER_CMD="$_CONF_SERVER_BUILD && $_CONF_SERVER_CMD"
    else
      SERVER_CMD="$_CONF_SERVER_CMD"
    fi
  fi
fi

# Attach if outside tmux, switch-client if inside tmux.
tmux_go() {
  local session="$1"
  if [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "=$session"
  else
    exec tmux attach -t "=$session"
  fi
}

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  tmux_go "$SESSION"
fi

# Claude is about to (re)launch: install the agent set first, so new agents and commands
# register. Never while Claude runs in an existing session (handled above).
if $NEW_SETUP || [[ -n "$GLOB" ]]; then
  if ! checkout_init "$START_DIR"; then
    [[ -n "$GLOB" ]] && exit 1
    echo "Continuing without a fresh agent set"
  fi
fi

WINDOW=1

# Window 1: claude
tmux new-session -d -s "$SESSION" -c "$START_DIR" -n claude
if [[ -n "$GLOB" ]]; then
  tmux send-keys -t "$SESSION":$WINDOW "claude '/run-glob $GLOB'" C-m
elif [[ -n "$REVIEW" ]]; then
  tmux send-keys -t "$SESSION":$WINDOW "claude '/run-glob --review $REVIEW'" C-m
else
  tmux send-keys -t "$SESSION":$WINDOW 'claude --continue' C-m
fi

# Window 2: console
WINDOW=$((WINDOW + 1))
tmux new-window  -t "$SESSION":$WINDOW -n console -c "$START_DIR"

# Window 3: editor
WINDOW=$((WINDOW + 1))
tmux new-window  -t "$SESSION":$WINDOW -n editor -c "$START_DIR"
tmux send-keys   -t "$SESSION":$WINDOW "nvim -c 'Git | only'" C-m

# Window 4: server (optional)
# Window 4: server (optional)
if [[ -n "$SERVER_CMD" ]]; then
  WINDOW=$((WINDOW + 1))
  tmux new-window  -t "$SESSION":$WINDOW -n server -c "$START_DIR"
  tmux send-keys   -t "$SESSION":$WINDOW "$SERVER_CMD" C-m
fi

tmux select-window -t "$SESSION":1
tmux_go "$SESSION"
